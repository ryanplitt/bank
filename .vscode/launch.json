{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Bank Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/BankGame/server/index.js",
      "cwd": "${workspaceFolder}/BankGame/server",
      "console": "integratedTerminal",
