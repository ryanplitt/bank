{
  "name": "bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multiplayer Bank dice game - one host leads and plays, everyone joins from their own device.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "BankGame/shared",
    "BankGame/server",
    "BankGame/client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @bank/server",
    "dev:client": "npm run dev --workspace @bank/client",
    "build": "npm run build --workspace @bank/client",
    "start": "npm run start --workspace @bank/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "vitest": "^4.1.11"
  }
}
